# Traefik Reverse Proxy - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required ---

# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Cloudflare API token with Zone:DNS:Edit permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=your-cloudflare-api-token

# --- Optional ---

# Bind to a specific IP (default: all interfaces)
# Useful when running alongside another reverse proxy on the same host
# LISTEN_IP=192.168.1.100

# DNS servers for ACME DNS-01 validation (default: 1.1.1.1:53,1.0.0.1:53)
# Override on hosts where Cloudflare DNS is unreachable, e.g. a Pi-hole host
# that can't DNAT its own traffic to external DNS
# DNS_RESOLVERS=127.0.0.1:53

# Seconds to wait after creating the ACME TXT record before asking Let's Encrypt
# to validate (default: 20). Raise it if renewals intermittently fail with
# "Incorrect TXT record" or "No TXT record found" and then succeed a day later
# ACME_PROPAGATION_DELAY=120

# Upstream proxies whose X-Forwarded-* headers Traefik keeps (default: none).
# Set only when another proxy sits in front of Traefik. Anyone who can connect
# from a listed address can choose the client IP the app sees. The WAF uses the
# same list. Restart with: docker compose up -d
#
# Behind Cloudflare's proxy (orange cloud): uncomment this line. It is Cloudflare's
# published list (https://www.cloudflare.com/ips/) as of 2026-10-11. Cloudflare
# adds new ranges there before using them; regenerate it with the command in the
# README's "Behind Cloudflare or Another Proxy" section.
# FORWARDED_TRUSTED_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# --- Web Application Firewall (optional) ---

# Run the bundled WAF (Coraza + OWASP Core Rule Set). Then add the "waf"
# middleware to a router in dynamic/config.yml. See the README first.
# COMPOSE_PROFILES=waf

# The mode a new install starts in: detect logs attacks and lets them through; block
# answers 403 (default: detect). Run detect for a while and add exclusions for false
# positives, then switch to block from Network Optimizer (Threat Intelligence - Web
# Application Firewall). The switch is saved in the waf-state volume and wins over this.
# WAF_MODE=detect

# CRS paranoia level 1-4 (default: 1). Higher catches more and false-positives more
# WAF_PARANOIA=1

# Shared secret for the WAF's API: Network Optimizer reads events and pushes its ban
# list and Trusted Sources with it (Settings - Security & Alerts). setup.sh generates
# one if this is empty; otherwise use: openssl rand -hex 32
# WAF_API_TOKEN=

# Address the WAF listens on (default: 127.0.0.1:8044). Keep it on loopback: the API
# is plain HTTP. Traefik, and Network Optimizer or the site's On-Site Agent on this
# host, reach it on localhost. From another host, use the waf-api router in
# dynamic/config.yml (HTTPS) rather than changing this.
# WAF_LISTEN=127.0.0.1:8044

# Traefik API/ping port on localhost (default: 8099)
# Change if 8099 conflicts with another service
# TRAEFIK_API_PORT=8099
