# Traefik secrets - box-only, do not commit real values
# Location on target: /usr/local/etc/traefik/secrets.env
#
# Copy and fill in your values on the target host:
#   sudo cp secrets.env.example /usr/local/etc/traefik/secrets.env
#   sudo chmod 600 /usr/local/etc/traefik/secrets.env

# Cloudflare User API Token for certificates (DNS-01), created under My Profile >
# API Tokens: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone - Zone - Read and Zone - DNS - Edit; Zone Resources: your domain.
# An Account API Token (cfat_ prefix) does not work here. This is not the token
# Network Optimizer's Cloudflare Edge Blocking uses.
CF_DNS_API_TOKEN=your-cloudflare-api-token
